.kilo/

# Training scratch space (see training/README.md) -- downloaded models,
# generated labels, checkpoints, and exported ONNX artifacts are not source
# and are not committed. The trained .onnx this eventually produces gets
# added deliberately in its own commit (loomhash/inference/models/).
training/models/
training/*.jsonl
training/*.pt
training/*.onnx

# Root-level drop zone for the Colab-downloaded model file -- not committed
# here; the committed copy lives at loomhash/inference/models/loom_engine_int8.onnx
/loom_engine_int8.onnx
/loom_engine_fp32.onnx
